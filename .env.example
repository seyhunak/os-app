# All optional. Copy to server/.env, which is git-ignored and loaded when the server starts. Never commit real values.

# Where OS keeps its database, token and encryption key. Default: ~/.os-app
# OS_DATA_DIR=

# Address to listen on. Keep 127.0.0.1 unless a TLS proxy or Tailscale sits in front.
# HOST=127.0.0.1
# PORT=8787

# Use your own token (24+ characters) instead of a generated one.
# OS_TOKEN=

# Set these to manage keys on the server instead of in the app.
# COMPOSIO_API_KEY=
# OPENROUTER_API_KEY=

# The Composio user your connected accounts belong to. Default: default
# OS_COMPOSIO_USER_ID=

# OpenRouter model, until you choose one in Settings. Default: qwen/qwen3.7-flash
# OS_MODEL=

# Goes in app/.env, not here. Prefills the server address in the mobile app. It's built into the app, so never put a token in it.
# EXPO_PUBLIC_OS_URL=https://your-machine.your-tailnet.ts.net:8443
